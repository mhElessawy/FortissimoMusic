@model Fortissimo.Models.Event
@{
    ViewData["Title"] = "تعديل فعالية";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Events" class="btn-outline-gold px-3 py-1 ms-3">
        <i class="fas fa-arrow-right ms-1"></i> رجوع
    </a>
    <h3 class="text-gold mb-0"><i class="fas fa-edit ms-2"></i> تعديل الفعالية</h3>
</div>

<div class="contact-form-card" style="max-width:700px;">
    <form asp-action="EditEvent" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" novalidate>
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="CreatedAt" type="hidden" />
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="EventDate" class="form-label"></label>
                <input asp-for="EventDate" type="datetime-local" class="form-control" />
                <span asp-validation-for="EventDate" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" />
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            </div>
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="col-12">
                    <label class="form-label text-gold">الصورة الحالية</label>
                    <div>
                        <img src="@Model.ImageUrl" style="height:100px; border-radius:8px; border:1px solid rgba(201,168,76,0.3);" />
                    </div>
                    <input asp-for="ImageUrl" type="hidden" />
                </div>
            }
            <div class="col-12">
                <label class="form-label text-gold">تغيير الصورة (اختياري)</label>
                <input type="file" name="imageFile" class="form-control" accept="image/*" />
            </div>
            <div class="col-12">
                <div class="form-check form-switch text-end">
                    <label class="form-check-label text-gold" for="IsActive">نشط</label>
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" id="IsActive" />
                </div>
            </div>
            <div class="col-12 text-end">
                <button type="submit" class="btn-gold px-4 py-2">
                    <i class="fas fa-save ms-1"></i> حفظ التغييرات
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
