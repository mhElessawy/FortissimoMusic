@model List<Fortissimo.Models.ContactMessage>
@{
    ViewData["Title"] = "الرسائل الواردة";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h3 class="text-gold mb-4"><i class="fas fa-envelope ms-2"></i> الرسائل الواردة</h3>

<div class="table-responsive">
    <table class="table table-dark-custom">
        <thead>
            <tr>
                <th>الاسم</th>
                <th>البريد</th>
                <th>الهاتف</th>
                <th>الرسالة</th>
                <th>التاريخ</th>
                <th>الحالة</th>
                <th>إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var msg in Model)
            {
                <tr class="@(!msg.IsRead ? "border-end border-warning border-3" : "")">
                    <td class="fw-bold">@msg.Name</td>
                    <td><a href="mailto:@msg.Email" class="text-gold">@msg.Email</a></td>
                    <td>@(msg.Phone ?? "-")</td>
                    <td style="max-width:250px;">
                        <small>@(msg.Message.Length > 80 ? msg.Message.Substring(0, 80) + "..." : msg.Message)</small>
                    </td>
                    <td><small>@msg.SentAt.ToString("dd/MM/yyyy HH:mm")</small></td>
                    <td>
                        @if (!msg.IsRead)
                        {
                            <span class="badge bg-warning text-dark">جديدة</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">مقروءة</span>
                        }
                    </td>
                    <td>
                        @if (!msg.IsRead)
                        {
                            <form asp-action="MarkRead" asp-route-id="@msg.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-success ms-1" title="تحديد كمقروءة">
                                    <i class="fas fa-check"></i>
                                </button>
                            </form>
                        }
                        <form asp-action="DeleteMessage" asp-route-id="@msg.Id" method="post" class="d-inline"
                              onsubmit="return confirm('حذف هذه الرسالة؟')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
