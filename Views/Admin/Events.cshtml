@model List<Fortissimo.Models.Event>
@{
    ViewData["Title"] = "إدارة الفعاليات";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="text-gold mb-0"><i class="fas fa-calendar-alt ms-2"></i> إدارة الفعاليات</h3>
    <a asp-action="CreateEvent" class="btn-gold px-3 py-2">
        <i class="fas fa-plus ms-1"></i> إضافة فعالية
    </a>
</div>

<div class="table-responsive">
    <table class="table table-dark-custom">
        <thead>
            <tr>
                <th>العنوان</th>
                <th>التاريخ</th>
                <th>المكان</th>
                <th>الحالة</th>
                <th>الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ev in Model)
            {
                <tr>
                    <td>@ev.Title</td>
                    <td>@ev.EventDate.ToString("dd/MM/yyyy hh:mm tt")</td>
                    <td>@(ev.Location ?? "-")</td>
                    <td>
                        @if (ev.IsActive)
                        {
                            <span class="badge bg-success">نشط</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">غير نشط</span>
                        }
                    </td>
                    <td>
                        <a asp-action="EditEvent" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-warning ms-1">
                            <i class="fas fa-edit"></i>
                        </a>
                        <form asp-action="DeleteEvent" asp-route-id="@ev.Id" method="post" class="d-inline"
                              onsubmit="return confirm('هل تريد حذف هذه الفعالية؟')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
