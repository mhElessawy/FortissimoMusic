@model Fortissimo.Models.Event
@{
    ViewData["Title"] = "إضافة فعالية";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Events" class="btn-outline-gold px-3 py-1 ms-3">
        <i class="fas fa-arrow-right ms-1"></i> رجوع
    </a>
    <h3 class="text-gold mb-0"><i class="fas fa-plus ms-2"></i> إضافة فعالية جديدة</h3>
</div>

<div class="contact-form-card" style="max-width:700px;">
    <form asp-action="CreateEvent" method="post" enctype="multipart/form-data" novalidate>
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" placeholder="عنوان الفعالية" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="EventDate" class="form-label"></label>
                <input asp-for="EventDate" type="datetime-local" class="form-control" />
                <span asp-validation-for="EventDate" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" placeholder="مكان الفعالية" />
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="وصف الفعالية..."></textarea>
            </div>
            <div class="col-12">
                <label class="form-label text-gold">صورة الفعالية</label>
                <input type="file" name="imageFile" class="form-control" accept="image/*" />
            </div>
            <div class="col-12">
                <div class="form-check form-switch text-end">
                    <label class="form-check-label text-gold" for="IsActive">نشط</label>
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" id="IsActive" checked />
                </div>
            </div>
            <div class="col-12 text-end">
                <button type="submit" class="btn-gold px-4 py-2">
                    <i class="fas fa-save ms-1"></i> حفظ الفعالية
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
