<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Fortissimo Music - أكاديمية موسيقية متخصصة في تعليم البيانو والكلارنيت" />
    <title>@ViewData["Title"] - Fortissimo Music</title>

    <!-- Bootstrap RTL -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <!-- Google Fonts Arabic -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&display=swap" rel="stylesheet" />
    <!-- Animate.css -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- TOP NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top fortissimo-navbar" id="mainNav">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <img src="/images/logo.svg" alt="Fortissimo" height="50" class="rounded-circle" />
                <span class="brand-text">Fortissimo <small>Music</small></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="fas fa-home ms-1"></i> الرئيسية
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="About">
                            <i class="fas fa-info-circle ms-1"></i> من نحن
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Events">
                            <i class="fas fa-calendar-alt ms-1"></i> فعالياتنا
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="CV">
                            <i class="fas fa-user-tie ms-1"></i> السيرة الذاتية
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Contact">
                            <i class="fas fa-envelope ms-1"></i> اتصل بنا
                        </a>
                    </li>
                </ul>
                @if (User.IsInRole("Admin"))
                {
                    <a class="btn btn-gold ms-2" asp-controller="Admin" asp-action="Index">
                        <i class="fas fa-cog ms-1"></i> لوحة التحكم
                    </a>
                }
            </div>
        </div>
    </nav>

    <!-- MAIN CONTENT -->
    <main>
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show m-3 text-end" role="alert">
                <i class="fas fa-check-circle ms-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="footer-dark pt-5 pb-3 mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6 text-end">
                    <div class="d-flex align-items-center gap-2 mb-3 justify-content-end">
                        <div>
                            <h5 class="text-gold mb-0">Fortissimo Music</h5>
                            <small class="text-muted">Fortissimo Music Academy</small>
                        </div>
                        <img src="/images/logo.svg" alt="Fortissimo" height="60" class="rounded-circle" />
                    </div>
                    <p class="text-muted">أكاديمية موسيقية متخصصة في تعليم البيانو والكلارنيت، نسعى لنشر الثقافة الموسيقية وتطوير مواهب الطلاب.</p>
                </div>
                <div class="col-lg-2 col-md-6 text-end">
                    <h6 class="text-gold mb-3">روابط سريعة</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                        <li><a asp-controller="Home" asp-action="About">من نحن</a></li>
                        <li><a asp-controller="Home" asp-action="Events">فعالياتنا</a></li>
                        <li><a asp-controller="Home" asp-action="CV">السيرة الذاتية</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">اتصل بنا</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6 text-end">
                    <h6 class="text-gold mb-3">تواصل معنا</h6>
                    <ul class="list-unstyled text-muted">
                        <li class="mb-2"><i class="fas fa-phone text-gold ms-2"></i> +20 100 000 0000</li>
                        <li class="mb-2"><i class="fas fa-envelope text-gold ms-2"></i> info@fortissimo-music.com</li>
                        <li class="mb-2"><i class="fas fa-map-marker-alt text-gold ms-2"></i> القاهرة، مصر</li>
                    </ul>
                    <div class="social-links mt-3">
                        <a href="#" class="social-link"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="social-link"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="social-link"><i class="fab fa-youtube"></i></a>
                        <a href="#" class="social-link"><i class="fab fa-tiktok"></i></a>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-gold mb-3 text-end">موقعنا على الخريطة</h6>
                    <div class="map-container rounded overflow-hidden">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3453.6!2d31.2357!3d30.0444!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMzDCsDAyJzM5LjkiTiAzMcKwMTQnMDguNSJF!5e0!3m2!1sar!2seg!4v1234567890"
                                width="100%" height="150" style="border:0;" allowfullscreen="" loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade" title="موقعنا على الخريطة">
                        </iframe>
                    </div>
                </div>
            </div>
            <hr class="border-secondary mt-4" />
            <div class="text-center text-muted">
                <small>&copy; 2026 Fortissimo Music - جميع الحقوق محفوظة</small>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>