<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fortissimo Admin Panel</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body style="padding-top:0;">
    <div class="d-flex">
        <!-- Sidebar -->
        <div class="admin-sidebar" style="width:260px; min-width:260px;">
            <div class="text-center mb-4 px-3">
                <img src="/images/logo.svg" alt="Fortissimo" class="rounded-circle mb-2" style="width:70px; height:70px; border:2px solid var(--gold);" />
                <div class="text-gold fw-bold">لوحة التحكم</div>
                <small class="text-muted">Fortissimo Music</small>
            </div>
            <nav class="nav flex-column">
                <a class="nav-link @(ViewData["Title"]?.ToString() == "لوحة التحكم" ? "active" : "")" asp-controller="Admin" asp-action="Index">
                    <i class="fas fa-tachometer-alt ms-2"></i> الرئيسية
                </a>
                <a class="nav-link @(ViewData["Title"]?.ToString()?.Contains("فعالي") == true ? "active" : "")" asp-controller="Admin" asp-action="Events">
                    <i class="fas fa-calendar-alt ms-2"></i> الفعاليات
                </a>
                <a class="nav-link @(ViewData["Title"]?.ToString()?.Contains("سلايدر") == true ? "active" : "")" asp-controller="Admin" asp-action="SliderImages">
                    <i class="fas fa-images ms-2"></i> صور السلايدر
                </a>
                <a class="nav-link @(ViewData["Title"]?.ToString()?.Contains("رسائل") == true ? "active" : "")" asp-controller="Admin" asp-action="Messages">
                    <i class="fas fa-envelope ms-2"></i> الرسائل
                </a>
                <hr style="border-color:rgba(201,168,76,0.2);" />
                <a class="nav-link" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-home ms-2"></i> عرض الموقع
                </a>
                <a class="nav-link" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/Home/Index">
                    <i class="fas fa-sign-out-alt ms-2"></i> تسجيل الخروج
                </a>
            </nav>
        </div>

        <!-- Main Content -->
        <div class="flex-grow-1" style="min-height:100vh; background: var(--dark-2); padding: 2rem;">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show text-end" role="alert">
                    <i class="fas fa-check-circle ms-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>