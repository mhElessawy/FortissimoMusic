@using Fortissimo.Models
@{
    ViewData["Title"] = "الرئيسية";
    var sliderImages = ViewBag.SliderImages as List<SliderImage> ?? new List<SliderImage>();
    var upcomingEvents = ViewBag.UpcomingEvents as List<Event> ?? new List<Event>();
    var galleryPhotos = ViewBag.GalleryPhotos as List<GalleryPhoto> ?? new List<GalleryPhoto>();
    var videos = ViewBag.Videos as List<VideoClip> ?? new List<VideoClip>();
}

@section Scripts {
<script>
    function openLightbox(src) {
        document.getElementById('lightboxImg').src = src;
        document.getElementById('galleryLightbox').classList.add('active');
        document.body.style.overflow = 'hidden';
    }
    function closeLightbox() {
        document.getElementById('galleryLightbox').classList.remove('active');
        document.body.style.overflow = '';
    }
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeLightbox();
    });
</script>
}

<!-- صورة الدكتورة + الكلام -->
<div class="hero-bio-section">
    <div class="hero-bio-inner">

        <!-- صورة د. شيرين — يمين في RTL (أول عنصر) -->
        <div class="hero-dr-col">
            <div class="hero-dr-frame">
                <img src="/images/dr-sherin.jpeg" alt="د. شيرين شكري"
                     class="hero-dr-img" onerror="this.src='/images/logo.svg'" />
            </div>
        </div>

        <!-- الكلام — يسار في RTL (تاني عنصر) -->
        <div class="hero-bio-col">
            <p class="hero-label mb-1">FOUNDER &amp; DIRECTOR</p>
            <h2 class="hero-name">د. شيرين شكري</h2>
            <p class="hero-name-en mb-3">Dr. Sherin Shokry</p>
            <p class="hero-bio-text">
                حاصلة على درجة الدكتوراه في الموسيقى من جمهورية مصر العربية، وتتمتع بخبرة متميزة في تعليم البيانو والكلارنيت وإعداد المواهب الموسيقية وفق أعلى المعايير الأكاديمية والفنية.
                أسست Fortissimo Music انطلاقًا من رؤية تهدف إلى نشر الثقافة الموسيقية الكلاسيكية، وتنمية الإبداع وصقل المواهب لدى الأطفال والشباب في دولة الكويت  ، من خلال بيئة تعليمية تجمع بين الاحتراف والإلهام.
                على مدار مسيرتها، نالت العديد من التكريمات الموسيقية المرموقة، كما شاركت في مهرجانات وحفلات  موسيقية، ممثلةً خبرتها الأكاديمية والفنية ، لتواصل رسالتها في الارتقاء بالتعليم الموسيقي وبناء جيل جديد من الموسيقيين المتميزين.

            </p>
            <div class="d-flex gap-2 flex-wrap mt-3 justify-content-end">
                <a asp-action="CV" class="btn-gold px-4 py-2">
                    <i class="fas fa-user-tie ms-1"></i> السيرة الذاتية
                </a>
                <a asp-action="Contact" class="btn-outline-gold px-4 py-2">
                    <i class="fas fa-envelope ms-1"></i> تواصل معها
                </a>
            </div>
        </div>

    </div>
</div>

<!-- ===== PHOTO GALLERY ===== -->
@if (galleryPhotos.Any())
{
    <section class="section-dark gallery-section">
        <div class="container">
            <div class="section-title">
                <h2>معرض الصور</h2>
                <div class="gold-divider"></div>
                <p>لحظات موسيقية لا تُنسى</p>
            </div>
            <div class="photo-gallery-grid">
                @foreach (var photo in galleryPhotos)
                {
                    <div class="gallery-item" onclick="openLightbox('/images/photo/@photo.FileName')">
                        <img src="/images/photo/@photo.FileName" alt="@(photo.Title ?? "صورة")" loading="lazy" />
                        <div class="gallery-overlay">
                            <i class="fas fa-expand"></i>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Lightbox -->
<div id="galleryLightbox" class="gallery-lightbox" onclick="closeLightbox()">
    <button class="lightbox-close" onclick="closeLightbox()">&times;</button>
    <img id="lightboxImg" src="" alt="" />
</div>

<!-- ===== VISION ===== -->
<section class="section-dark">
    <div class="container">
        <div class="section-title">
            <h2>رؤيتنا</h2>
            <div class="gold-divider"></div>
            <p>نؤمن بأن الموسيقى لغة الروح وجسر التواصل بين الشعوب</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="vision-card">
                    <div class="vision-icon">
                        <i class="fas fa-star"></i>
                    </div>
                    <h5 class="text-gold mb-2">رؤيتنا</h5>
                    <p class="text-muted">أن أترك بصمة لا تُقاس بعدد الطلاب الذين تعلموا الموسيقى، بل بعدد الأرواح التي اكتشفت شغفها، وآمنت بقدراتها، وصنعت مستقبلها من خلال الفن. رؤيتي أن تصبح الموسيقى أسلوب حياة، وجسرًا للإبداع، ووسيلة لبناء إنسان أكثر ثقةً ووعيًا وجمالًا</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="vision-card">
                    <div class="vision-icon">
                        <i class="fas fa-bullseye"></i>
                    </div>
                    <h5 class="text-gold mb-2">رسالتنا</h5>
                    <p class="text-muted">نلتزم بتقديم تعليم موسيقي احترافي وفق أعلى المعايير الأكاديمية والفنية، في بيئة تعليمية ملهمة تنمّي الإبداع، وتعزز الثقة بالنفس، وتصقل المواهب، من خلال برامج متخصصة،  وتجارب تعليمية مبتكرة، لتمكين كل طالب من تحقيق إمكاناته الفنية والوصول إلى التميز محليًا ودوليًا</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="vision-card">
                    <div class="vision-icon">
                        <i class="fas fa-heart"></i>
                    </div>
                    <h5 class="text-gold mb-2">قيمنا</h5>
                    <p class="text-muted">
                  
                        نسعى إلى نشر الثقافة الموسيقية وإبراز دور الفن في تنمية الإنسان والمجتمع
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== VIDEOS ===== -->
@if (videos.Any())
{
    <section class="section-dark">
        <div class="container">
            <div class="section-title">
                <h2>لقطات موسيقية</h2>
                <div class="gold-divider"></div>
                <p>استمتع بأجمل اللحظات الموسيقية من Fortissimo Academy</p>
            </div>
            <div class="row g-4">
                @foreach (var video in videos)
                {
                    <div class="col-md-6">
                        <div class="video-card">
                            <div class="video-wrapper">
                                <video controls>
                                    <source src="/Vedio/@video.FileName" />
                                </video>
                            </div>
                            <div class="video-card-body">
                                <h4><i class="fas fa-music ms-2"></i> @video.Title</h4>
                                @if (!string.IsNullOrEmpty(video.Description))
                                {
                                    <p class="text-muted mb-0">@video.Description</p>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- ===== UPCOMING EVENTS ===== -->
@if (upcomingEvents.Any())
{
    <section class="section-darker">
        <div class="container">
            <div class="section-title">
                <h2>فعالياتنا القادمة</h2>
                <div class="gold-divider"></div>
                <p>لا تفوّت أجمل الفعاليات الموسيقية</p>
            </div>
            <div class="row g-4">
                @foreach (var ev in upcomingEvents)
                {
                    <div class="col-md-4">
                        <div class="event-card">
                            @if (!string.IsNullOrEmpty(ev.ImageUrl))
                            {
                                <img src="@ev.ImageUrl" class="event-card-img" alt="@ev.Title" />
                            }
                            else
                            {
                                <div class="event-card-img-placeholder">
                                    <i class="fas fa-music"></i>
                                </div>
                            }
                            <div class="event-card-body">
                                <div class="event-date-badge">
                                    <i class="fas fa-calendar"></i>
                                    @ev.EventDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ar-EG"))
                                </div>
                                <h5>@ev.Title</h5>
                                @if (!string.IsNullOrEmpty(ev.Description))
                                {
                                    <p class="text-muted small">@ev.Description</p>
                                }
                                @if (!string.IsNullOrEmpty(ev.Location))
                                {
                                    <div class="event-location">
                                        <i class="fas fa-map-marker-alt text-gold ms-1"></i> @ev.Location
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="text-center mt-4">
                <a asp-action="Events" class="btn-outline-gold px-4 py-2">
                    <i class="fas fa-calendar-alt ms-1"></i> عرض كل الفعاليات
                </a>
            </div>
        </div>
    </section>
}

<!-- ===== GOOGLE MAP ===== -->
<section class="section-dark map-section">
    <div class="container">
        <div class="section-title">
            <h2>موقعنا</h2>
            <div class="gold-divider"></div>
            <p>تفضل بزيارتنا في Fortissimo Music Academy</p>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="rounded overflow-hidden border" style="border-color: rgba(201,168,76,0.3) !important;">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d231.30!2d47.9774!3d29.3759!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3fcf9cb3b7ad1aad%3A0x3e2a2f5de95e7d98!2sKuwait%20City%2C%20Kuwait!5e0!3m2!1sar!2skw!4v1750000000000!5m2!1sar!2skw"
                            width="100%" height="400" style="border:0;" allowfullscreen="" loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade" title="موقع Fortissimo Academy - الكويت">
                    </iframe>
                </div>
                <div class="text-center mt-3">
                    <a href="https://maps.google.com" target="_blank" class="btn-gold px-4 py-2">
                        <i class="fas fa-directions ms-1"></i> احصل على الاتجاهات
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
