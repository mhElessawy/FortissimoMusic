@using Fortissimo.Models
@{
    ViewData["Title"] = "الرئيسية";
    var sliderImages = ViewBag.SliderImages as List<SliderImage> ?? new List<SliderImage>();
    var upcomingEvents = ViewBag.UpcomingEvents as List<Event> ?? new List<Event>();
}

<!-- ===== HERO ===== -->
<section class="hero-section">

    <!-- الجزء العلوي: الصور + صورة الدكتورة -->
    <div class="hero-top row g-0">

        <!-- صور الأكاديمية - carousel -->
        <div class="col-8 col-md-9 hero-carousel-col">
            @if (sliderImages.Any())
            {
                <div id="heroCarousel" class="carousel slide h-100" data-bs-ride="carousel" data-bs-interval="4000">
                    <div class="carousel-inner h-100">
                        @for (int i = 0; i < sliderImages.Count; i++)
                        {
                            var img = sliderImages[i];
                            <div class="carousel-item h-100 @(i == 0 ? "active" : "")">
                                <img src="@img.ImageUrl" alt="@img.Title" class="hero-portrait-img" />
                            </div>
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                    <div class="carousel-indicators hero-indicators">
                        @for (int i = 0; i < sliderImages.Count; i++)
                        {
                            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="@i"
                                    class="@(i == 0 ? "active" : "")" aria-label="Slide @(i + 1)"></button>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="h-100 d-flex align-items-center justify-content-center hero-no-img">
                    <i class="fas fa-images"></i>
                </div>
            }
        </div>

        <!-- صورة الدكتورة شيرين -->
        <div class="col-4 col-md-3 hero-dr-col">
            <div class="hero-dr-img-wrap">
                <img src="/images/dr-sherin.jpeg" alt="د. شيرين شكري" class="hero-dr-img"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                <div class="hero-dr-fallback">
                    <i class="fas fa-user-circle"></i>
                </div>
                <div class="hero-dr-badge">
                    <i class="fas fa-music ms-1"></i> المؤسسة
                </div>
            </div>
        </div>

    </div>

    <!-- الجزء السفلي: الكلام -->
    <div class="hero-bottom">
        <div class="container-fluid">
            <div class="row align-items-center g-3">

                <!-- الاسم والتخصصات -->
                <div class="col-lg-5 text-end">
                    <p class="hero-bio-label mb-1">FOUNDER &amp; DIRECTOR</p>
                    <h1 class="hero-bio-name mb-0">د. شيرين شكري</h1>
                    <p class="hero-bio-name-en">Dr. Sherin Shokry</p>
                    <div class="hero-badges">
                        <span class="hero-badge"><i class="fas fa-music ms-1"></i> بيانو وكلارنيت</span>
                        <span class="hero-badge"><i class="fas fa-graduation-cap ms-1"></i> ماجستير موسيقى</span>
                        <span class="hero-badge"><i class="fas fa-globe ms-1"></i> خبرة دولية</span>
                    </div>
                </div>

                <!-- الإحصائيات -->
                <div class="col-lg-4">
                    <div class="row g-2 text-center">
                        <div class="col-4">
                            <div class="hero-stat">
                                <div class="hero-stat-number">+500</div>
                                <div class="hero-stat-label">طالب متخرج</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="hero-stat">
                                <div class="hero-stat-number">+10</div>
                                <div class="hero-stat-label">سنوات خبرة</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="hero-stat">
                                <div class="hero-stat-number">+50</div>
                                <div class="hero-stat-label">حفل موسيقي</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- الأزرار -->
                <div class="col-lg-3 d-flex flex-column gap-2 align-items-start">
                    <a asp-action="CV" class="btn-gold px-4 py-2 w-100 text-center">
                        <i class="fas fa-user-tie ms-1"></i> السيرة الذاتية
                    </a>
                    <a asp-action="Contact" class="btn-outline-gold px-4 py-2 w-100 text-center">
                        <i class="fas fa-envelope ms-1"></i> تواصل معها
                    </a>
                </div>

            </div>
        </div>
    </div>

</section>

<!-- ===== VISION ===== -->
<section class="section-dark">
    <div class="container">
        <div class="section-title">
            <h2>رؤيتنا</h2>
            <div class="gold-divider"></div>
            <p>نؤمن بأن الموسيقى لغة الروح وجسر التواصل بين الشعوب</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="vision-card">
                    <div class="vision-icon">
                        <i class="fas fa-star"></i>
                    </div>
                    <h5 class="text-gold mb-2">رؤيتنا</h5>
                    <p class="text-muted">أن نكون المرجع الأول في تعليم الموسيقى الكلاسيكية في مصر والعالم العربي، ونسهم في بناء جيل موسيقي متميز قادر على حمل الرسالة الفنية.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="vision-card">
                    <div class="vision-icon">
                        <i class="fas fa-bullseye"></i>
                    </div>
                    <h5 class="text-gold mb-2">رسالتنا</h5>
                    <p class="text-muted">تقديم تعليم موسيقي راقٍ يجمع بين الأصالة والمعاصرة، من خلال مناهج علمية متطورة وأساتذة متخصصين يُلهمون الطلاب ويكتشفون مواهبهم.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="vision-card">
                    <div class="vision-icon">
                        <i class="fas fa-heart"></i>
                    </div>
                    <h5 class="text-gold mb-2">قيمنا</h5>
                    <p class="text-muted">الإبداع والتميز والالتزام والشغف بالموسيقى. نؤمن بقدرة كل طالب على الوصول إلى أعلى مستويات الأداء الموسيقي بالتدريب والمثابرة.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== VIDEOS ===== -->
<section class="section-dark">
    <div class="container">
        <div class="section-title">
            <h2>لقطات موسيقية</h2>
            <div class="gold-divider"></div>
            <p>استمتع بأجمل اللحظات الموسيقية من Fortissimo Academy</p>
        </div>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="video-card">
                    <div class="video-wrapper">
                        <iframe src="https://www.youtube.com/embed/TnmlnSXSk0s?rel=0&modestbranding=1"
                                title="عزف البيانو - Fortissimo Music"
                                frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                allowfullscreen>
                        </iframe>
                    </div>
                    <div class="video-card-body">
                        <h4><i class="fas fa-music ms-2"></i> البيانو</h4>
                        <p class="text-muted mb-0">فن العزف على البيانو - رحلة النغمات الخالدة</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="video-card">
                    <div class="video-wrapper">
                        <iframe src="https://www.youtube.com/embed/eSMiRcJLuiI?rel=0&modestbranding=1"
                                title="عزف الكلارنيت - Fortissimo Music"
                                frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                allowfullscreen>
                        </iframe>
                    </div>
                    <div class="video-card-body">
                        <h4><i class="fas fa-wind ms-2"></i> الكلارنيت</h4>
                        <p class="text-muted mb-0">سحر الكلارنيت - صوت يسكن القلوب</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== UPCOMING EVENTS ===== -->
@if (upcomingEvents.Any())
{
    <section class="section-darker">
        <div class="container">
            <div class="section-title">
                <h2>فعالياتنا القادمة</h2>
                <div class="gold-divider"></div>
                <p>لا تفوّت أجمل الفعاليات الموسيقية</p>
            </div>
            <div class="row g-4">
                @foreach (var ev in upcomingEvents)
                {
                    <div class="col-md-4">
                        <div class="event-card">
                            @if (!string.IsNullOrEmpty(ev.ImageUrl))
                            {
                                <img src="@ev.ImageUrl" class="event-card-img" alt="@ev.Title" />
                            }
                            else
                            {
                                <div class="event-card-img-placeholder">
                                    <i class="fas fa-music"></i>
                                </div>
                            }
                            <div class="event-card-body">
                                <div class="event-date-badge">
                                    <i class="fas fa-calendar"></i>
                                    @ev.EventDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ar-EG"))
                                </div>
                                <h5>@ev.Title</h5>
                                @if (!string.IsNullOrEmpty(ev.Description))
                                {
                                    <p class="text-muted small">@ev.Description</p>
                                }
                                @if (!string.IsNullOrEmpty(ev.Location))
                                {
                                    <div class="event-location">
                                        <i class="fas fa-map-marker-alt text-gold ms-1"></i> @ev.Location
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="text-center mt-4">
                <a asp-action="Events" class="btn-outline-gold px-4 py-2">
                    <i class="fas fa-calendar-alt ms-1"></i> عرض كل الفعاليات
                </a>
            </div>
        </div>
    </section>
}

<!-- ===== GOOGLE MAP ===== -->
<section class="section-dark map-section">
    <div class="container">
        <div class="section-title">
            <h2>موقعنا</h2>
            <div class="gold-divider"></div>
            <p>تفضل بزيارتنا في Fortissimo Music Academy</p>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="rounded overflow-hidden border" style="border-color: rgba(201,168,76,0.3) !important;">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d110951.96683503906!2d31.18380339999999!3d30.059482799999998!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14583fa60b21beeb%3A0x79dfb296e8423bba!2sCairo%2C%20Cairo%20Governorate%2C%20Egypt!5e0!3m2!1sen!2sus!4v1750665060606!5m2!1sen!2sus"
                            width="100%" height="400" style="border:0;" allowfullscreen="" loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade" title="موقع Fortissimo Academy">
                    </iframe>
                </div>
                <div class="text-center mt-3">
                    <a href="https://maps.google.com" target="_blank" class="btn-gold px-4 py-2">
                        <i class="fas fa-directions ms-1"></i> احصل على الاتجاهات
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>