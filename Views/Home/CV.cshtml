@{
    ViewData["Title"] = "السيرة الذاتية";
}

<!-- Page Hero -->
<div class="page-hero">
    <div class="container">
        <h1><i class="fas fa-user-tie ms-2"></i> السيرة الذاتية</h1>
        <p>د. شيرين شكري - مؤسسة Fortissimo Music</p>
    </div>
</div>

<section class="section-dark">
    <div class="container">
        <div class="row g-5">
            <!-- Profile Card -->
            <div class="col-lg-4 text-center">
                <div class="vision-card">
                    <div class="mb-3">
                        <div class="founder-img-wrapper d-inline-block">
                            <img src="/images/dr-sherin.jpeg"
                                 alt="د. شيرين شكري"
                                 class="founder-img"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                            <div class="founder-img-placeholder" style="display:none;">
                                <i class="fas fa-user-circle"></i>
                            </div>
                        </div>
                    </div>
                    <h4 class="text-gold">د. شيرين شكري</h4>
                    <p class="text-muted mb-1 small">Dr. Sherin Shokry</p>
                    <p class="text-muted mb-3">عازفة كلارنيت وبيانو متخصصة، وأكاديمية ومربية موسيقية</p>
                    <hr style="border-color: rgba(201,168,76,0.2);">
                    <div class="d-flex flex-column gap-2 text-end mt-3">
                        <div><i class="fas fa-music text-gold ms-2"></i> <span class="text-muted small">بيانو وكلارنيت</span></div>
                        <div><i class="fas fa-graduation-cap text-gold ms-2"></i> <span class="text-muted small">دكتوراه في فلسفة التربية الموسيقية</span></div>
                        <div><i class="fas fa-globe text-gold ms-2"></i> <span class="text-muted small">خبرة دولية تمتد لأكثر من 26 عاماً</span></div>
                        <div><i class="fas fa-award text-gold ms-2"></i> <span class="text-muted small">مشاركات أوركسترالية دولية</span></div>
                    </div>
                </div>
            </div>

            <!-- Bio -->
            <div class="col-lg-8">
                <h3 class="text-gold mb-2 text-start">نبذة تعريفية</h3>
                <div class="gold-divider mb-4" style="margin-right:0; margin-left:auto;"></div>

                <p class="text-muted text-start mb-4">
                    تتمتع الدكتورة شيرين شكري بخبرة تربوية وفنية تمتد لأكثر من 26 عاماً في مجال التربية الموسيقية والأداء الأوركسترالي.
                    حاصلة على درجة الدكتوراه في فلسفة التربية الموسيقية (تخصص كلارنيت - بيانو) من جامعة حلوان عام 2024، والماجستير عام 2018،
                    إلى جانب بكالوريوس المعهد العالي للفنون الموسيقية بدولة الكويت لعام 1999 (تخصص كلارنيت وبيانو).
                </p>
                <p class="text-muted text-start mb-4">
                    تتولى د. شيرين تدريس التربية الموسيقية بوزارة التربية (ثانوية مارية القبطية - بنات)، إلى جانب عملها دكتورة منتدبة بكلية التربية الأساسية (قسم الموسيقى).
                </p>

                <h4 class="text-gold mb-3 text-start">المشاركات الفنية والأوركسترالية</h4>
                <div class="cv-timeline">
                    <div class="cv-item">
                        <div class="cv-year">1996 - 2006</div>
                        <p class="text-muted small mb-0">عازفة كلارنيت في فرقة المجلس الوطني.</p>
                         <p class="text-muted small mb-0">المشاركة في اسبوع الموسيقى العربية (القاهرة ) في دار الأوبرا.</p>
                    </div>
                    <div class="cv-item">
                        <div class="cv-year">2005</div>
                        <p class="text-muted small mb-0">المشاركة في أسبوع اليونسكو بفرنسا.</p>
                    </div>
                    <div class="cv-item">
                        <div class="cv-year">1999 - 2013</div>
                        <p class="text-muted small mb-0">المشاركة في مهرجان القرين ومهرجان الموسيقى.</p>
                    </div>
                    <div class="cv-item">
                        <div class="cv-year">2017 - 2022</div>
                        <p class="text-muted small mb-0">مشاركات فنية بدار الأوبرا الكويتية - مركز جابر الأحمد الثقافي.</p>
                         <p class="text-muted small mb-0">المشاركات الدولية في الرياض - قطر - مركز جابر الأحمد الثقافي.</p>
                        <p class="text-muted small mb-0">عازفة أساسية في مجموعة رباعي كلارنيت (Clarinet Lovers) لموسيقى الحجرة والمشاركات بدار الآثار الإسلامية.</p>
                    </div>
                    <div class="cv-item">
                        <div class="cv-year">2024 - 2025</div>
                        <p class="text-muted small mb-0">المشاركة مع الأوركسترا الحضرمية بمركز الشيخ جابر الأحمد الثقافي (2024)، وحفل يناير (2025).</p>
                    </div>
                    <div class="cv-item">
                        <div class="cv-year">2024</div>
                        <p class="text-muted small mb-0">المشاركة مع الفنانة عبير نعمة بلمسات المايسترو أندريه معلولي.</p>
                    </div>
                    <div class="cv-item">
                        <div class="cv-year">2026</div>
                        <p class="text-muted small mb-0">المشاركة في ثنائي كلارنيت (Duo Clarinet) ضمن حفلات Kuwait Music Academy Concert.</p>
                    </div>
                </div>

                <!-- Skills -->
                <h4 class="text-gold mb-3 mt-4 text-start">التخصصات الموسيقية</h4>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="vision-card" style="padding: 1.2rem;">
                            <div class="d-flex align-items-center gap-2">
                                <div class="vision-icon" style="width:45px; height:45px; font-size:1.2rem; flex-shrink:0;">
                                    <i class="fas fa-music"></i>
                                </div>
                                <div>
                                    <h6 class="text-gold mb-0">البيانو الكلاسيكي</h6>
                                    <small class="text-muted">مستوى احترافي</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="vision-card" style="padding: 1.2rem;">
                            <div class="d-flex align-items-center gap-2">
                                <div class="vision-icon" style="width:45px; height:45px; font-size:1.2rem; flex-shrink:0;">
                                    <i class="fas fa-wind"></i>
                                </div>
                                <div>
                                    <h6 class="text-gold mb-0">الكلارنيت</h6>
                                    <small class="text-muted">مستوى احترافي</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="vision-card" style="padding: 1.2rem;">
                            <div class="d-flex align-items-center gap-2">
                                <div class="vision-icon" style="width:45px; height:45px; font-size:1.2rem; flex-shrink:0;">
                                    <i class="fas fa-book"></i>
                                </div>
                                <div>
                                    <h6 class="text-gold mb-0">نظرية الموسيقى</h6>
                                    <small class="text-muted">تدريس متقدم</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="vision-card" style="padding: 1.2rem;">
                            <div class="d-flex align-items-center gap-2">
                                <div class="vision-icon" style="width:45px; height:45px; font-size:1.2rem; flex-shrink:0;">
                                    <i class="fas fa-microphone"></i>
                                </div>
                                <div>
                                    <h6 class="text-gold mb-0">الأداء والحفلات</h6>
                                    <small class="text-muted">خبرة دولية</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>