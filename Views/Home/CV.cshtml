@{
    ViewData["Title"] = "السيرة الذاتية";
}

<!-- Page Hero -->
<div class="page-hero">
    <div class="container">
        <h1><i class="fas fa-user-tie ms-2"></i> السيرة الذاتية</h1>
        <p>د. شيرين شكري - مؤسسة Fortissimo Music</p>
    </div>
</div>

<section class="section-dark">
    <div class="container">
        <div class="row g-5">
            <!-- Profile Card -->
            <div class="col-lg-4 text-center">
                <div class="vision-card">
                    <div class="mb-3">
                        <img src="/images/dr-sherin.jpg"
                             alt="د. شيرين شكري"
                             class="rounded-circle"
                             style="width:180px; height:180px; object-fit:cover; object-position:top center; border:3px solid var(--gold); box-shadow: 0 8px 25px rgba(201,168,76,0.3);"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div style="display:none; width:180px; height:180px; background:linear-gradient(135deg,rgba(201,168,76,0.2),rgba(201,168,76,0.05)); border:3px solid var(--gold); border-radius:50%; align-items:center; justify-content:center; margin:0 auto;">
                            <i class="fas fa-user-circle" style="font-size:5rem; color:var(--gold);"></i>
                        </div>
                    </div>
                    <h4 class="text-gold">د. شيرين شكري</h4>
                    <p class="text-muted mb-1 small">Dr. Sherin Shokry</p>
                    <p class="text-muted mb-3">مؤسسة ومديرة Fortissimo Music</p>
                    <hr style="border-color: rgba(201,168,76,0.2);">
                    <div class="d-flex flex-column gap-2 text-end mt-3">
                        <div><i class="fas fa-music text-gold ms-2"></i> <span class="text-muted small">بيانو وكلارنيت</span></div>
                        <div><i class="fas fa-graduation-cap text-gold ms-2"></i> <span class="text-muted small">ماجستير موسيقى</span></div>
                        <div><i class="fas fa-globe text-gold ms-2"></i> <span class="text-muted small">خبرة دولية</span></div>
                        <div><i class="fas fa-award text-gold ms-2"></i> <span class="text-muted small">جوائز موسيقية</span></div>
                    </div>
                </div>
            </div>

            <!-- Timeline -->
            <div class="col-lg-8">
                <h3 class="text-gold mb-2 text-end">المسيرة الموسيقية</h3>
                <div class="gold-divider mb-4" style="margin-right:0; margin-left:auto;"></div>

                <div class="cv-timeline">
                    <div class="cv-item">
                        <div class="cv-year">2005 - 2009</div>
                        <h5 class="text-white mb-1">دراسة الموسيقى الكلاسيكية</h5>
                        <p class="text-muted small">حصل على درجة البكالوريوس في الموسيقى الكلاسيكية مع التخصص في البيانو والكلارنيت، وتخرج بمرتبة الشرف الأولى.</p>
                    </div>
                    <div class="cv-item">
                        <div class="cv-year">2010 - 2013</div>
                        <h5 class="text-white mb-1">الدراسات العليا والتخصص الدولي</h5>
                        <p class="text-muted small">أكمل دراساته العليا في أوروبا وتخصص في الأداء الكلاسيكي والتدريس الموسيقي المتقدم، مع المشاركة في أوركسترا دولية مرموقة.</p>
                    </div>
                    <div class="cv-item">
                        <div class="cv-year">2013 - 2015</div>
                        <h5 class="text-white mb-1">العودة وبدء مسيرة التدريس</h5>
                        <p class="text-muted small">عاد إلى مصر وبدأ رحلته في التدريس الموسيقي، مؤمناً برسالة نشر الثقافة الموسيقية وتطوير المواهب المحلية.</p>
                    </div>
                    <div class="cv-item">
                        <div class="cv-year">2015</div>
                        <h5 class="text-white mb-1">تأسيس Fortissimo Academy</h5>
                        <p class="text-muted small">أسس Fortissimo Music Academy لتكون بيتاً للفن والإبداع الموسيقي، وبدأت الأكاديمية تنمو وتتطور عاماً بعد عام.</p>
                    </div>
                    <div class="cv-item">
                        <div class="cv-year">2015 - الآن</div>
                        <h5 class="text-white mb-1">الإنجازات والجوائز</h5>
                        <p class="text-muted small">حقق طلاب الأكاديمية مراكز متقدمة في مسابقات موسيقية محلية ودولية، وأُقيمت عشرات الحفلات الموسيقية المتميزة تحت إشراف الأستاذ المؤسس.</p>
                    </div>
                </div>

                <!-- Skills -->
                <h4 class="text-gold mb-3 mt-4 text-end">التخصصات الموسيقية</h4>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="vision-card" style="padding: 1.2rem;">
                            <div class="d-flex align-items-center gap-2">
                                <div class="vision-icon" style="width:45px; height:45px; font-size:1.2rem; flex-shrink:0;">
                                    <i class="fas fa-music"></i>
                                </div>
                                <div>
                                    <h6 class="text-gold mb-0">البيانو الكلاسيكي</h6>
                                    <small class="text-muted">مستوى احترافي</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="vision-card" style="padding: 1.2rem;">
                            <div class="d-flex align-items-center gap-2">
                                <div class="vision-icon" style="width:45px; height:45px; font-size:1.2rem; flex-shrink:0;">
                                    <i class="fas fa-wind"></i>
                                </div>
                                <div>
                                    <h6 class="text-gold mb-0">الكلارنيت</h6>
                                    <small class="text-muted">مستوى احترافي</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="vision-card" style="padding: 1.2rem;">
                            <div class="d-flex align-items-center gap-2">
                                <div class="vision-icon" style="width:45px; height:45px; font-size:1.2rem; flex-shrink:0;">
                                    <i class="fas fa-book"></i>
                                </div>
                                <div>
                                    <h6 class="text-gold mb-0">نظرية الموسيقى</h6>
                                    <small class="text-muted">تدريس متقدم</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="vision-card" style="padding: 1.2rem;">
                            <div class="d-flex align-items-center gap-2">
                                <div class="vision-icon" style="width:45px; height:45px; font-size:1.2rem; flex-shrink:0;">
                                    <i class="fas fa-microphone"></i>
                                </div>
                                <div>
                                    <h6 class="text-gold mb-0">الأداء والحفلات</h6>
                                    <small class="text-muted">خبرة دولية</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>