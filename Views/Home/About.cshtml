@{
    ViewData["Title"] = "من نحن";
}

<!-- Page Hero -->
<div class="page-hero">
    <div class="container">
        <h1><i class="fas fa-info-circle ms-2"></i> من نحن</h1>
        <p>تعرف على قصتنا وشغفنا بالموسيقى</p>
    </div>
</div>

<!-- About Section -->
<section class="section-dark">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6 text-end">
                <h2 class="text-gold mb-3">Fortissimo Music Academy</h2>
                <div class="gold-divider mb-3" style="margin-right: 0; margin-left: auto; text-align: right;"></div>
                <p style="color: #ccc; line-height: 2; font-size: 1.05rem;">
                    تأسست Fortissimo Music Academy بشغف حقيقي وحب عميق للفن الموسيقي، لتكون منارة ثقافية وفنية في مجال تعليم الموسيقى الكلاسيكية. نقدم تعليماً موسيقياً متميزاً يجمع بين المنهج الأكاديمي الصارم والإبداع الفني الحر.
                </p>
                <p style="color: #aaa; line-height: 2;">
                    منذ تأسيسها، حرصت الأكاديمية على توفير بيئة تعليمية متكاملة تُشجع الطلاب على اكتشاف مواهبهم وصقلها، من خلال أساتذة متخصصين ذوي خبرة عالية ومناهج تعليمية مطورة تناسب جميع الأعمار والمستويات.
                </p>

                <div class="mt-4">
                    <div class="about-feature">
                        <div class="about-feature-icon">
                            <i class="fas fa-graduation-cap"></i>
                        </div>
                        <div>
                            <h6 class="text-gold mb-1">تعليم أكاديمي متخصص</h6>
                            <p class="text-muted mb-0 small">مناهج معتمدة دولياً في تعليم البيانو والكلارنيت</p>
                        </div>
                    </div>
                    <div class="about-feature">
                        <div class="about-feature-icon">
                            <i class="fas fa-users"></i>
                        </div>
                        <div>
                            <h6 class="text-gold mb-1">أساتذة متميزون</h6>
                            <p class="text-muted mb-0 small">فريق من أفضل المعلمين الموسيقيين في مصر والعالم</p>
                        </div>
                    </div>
                    <div class="about-feature">
                        <div class="about-feature-icon">
                            <i class="fas fa-trophy"></i>
                        </div>
                        <div>
                            <h6 class="text-gold mb-1">إنجازات وجوائز</h6>
                            <p class="text-muted mb-0 small">طلابنا يحققون المراكز الأولى في المسابقات الموسيقية</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <div class="position-relative">
                    <div style="width:280px; height:280px; background: linear-gradient(135deg, rgba(201,168,76,0.1), rgba(201,168,76,0.05)); border: 3px solid var(--gold); border-radius: 50%; display:flex; align-items:center; justify-content:center; margin: 0 auto;">
                        <img src="/images/logo.svg" alt="Fortissimo" class="rounded-circle"
                             style="width:220px; height:220px; object-fit:cover;" />
                    </div>
                    <div style="position:absolute; top:-20px; right:calc(50% - 160px); width:60px; height:60px; background:var(--gold); border-radius:50%; display:flex; align-items:center; justify-content:center;">
                        <i class="fas fa-music text-dark fs-4"></i>
                    </div>
                    <div style="position:absolute; bottom:-10px; left:calc(50% - 160px); width:50px; height:50px; background:rgba(201,168,76,0.3); border:2px solid var(--gold); border-radius:50%; display:flex; align-items:center; justify-content:center;">
                        <i class="fas fa-star text-gold"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Team Section -->
<section class="section-darker">
    <div class="container">
        <div class="section-title">
            <h2>لماذا تختار Fortissimo؟</h2>
            <div class="gold-divider"></div>
        </div>
        <div class="row g-4">
            <div class="col-md-3 col-sm-6">
                <div class="vision-card text-center">
                    <div class="vision-icon"><i class="fas fa-piano"></i></div>
                    <h6 class="text-gold">تعليم البيانو</h6>
                    <p class="text-muted small">من المستوى المبتدئ حتى الاحترافي</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="vision-card text-center">
                    <div class="vision-icon"><i class="fas fa-wind"></i></div>
                    <h6 class="text-gold">تعليم الكلارنيت</h6>
                    <p class="text-muted small">إتقان آلة الكلارنيت بأسلوب احترافي</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="vision-card text-center">
                    <div class="vision-icon"><i class="fas fa-microphone"></i></div>
                    <h6 class="text-gold">حفلات دورية</h6>
                    <p class="text-muted small">حفلات وعروض للطلاب طوال العام</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="vision-card text-center">
                    <div class="vision-icon"><i class="fas fa-certificate"></i></div>
                    <h6 class="text-gold">شهادات معتمدة</h6>
                    <p class="text-muted small">شهادات إتمام معتمدة دولياً</p>
                </div>
            </div>
        </div>
    </div>
</section>