@model List<Fortissimo.Models.Event>
@{
    ViewData["Title"] = "فعالياتنا";
}

<!-- Page Hero -->
<div class="page-hero">
    <div class="container">
        <h1><i class="fas fa-calendar-alt ms-2"></i> فعالياتنا</h1>
        <p>تابع آخر أخبار وفعاليات Fortissimo Music Academy</p>
    </div>
</div>

<!-- Events Grid -->
<section class="section-dark">
    <div class="container">
        @if (Model != null && Model.Any())
        {
            var upcoming = Model.Where(e => e.EventDate >= DateTime.Now).ToList();
            var past = Model.Where(e => e.EventDate < DateTime.Now).ToList();

            if (upcoming.Any())
            {
                <h3 class="text-gold mb-4 text-end"><i class="fas fa-fire ms-2"></i> الفعاليات القادمة</h3>
                <div class="row g-4 mb-5">
                    @foreach (var ev in upcoming)
                    {
                        <div class="col-lg-4 col-md-6">
                            <div class="event-card">
                                @if (!string.IsNullOrEmpty(ev.ImageUrl))
                                {
                                    <img src="@ev.ImageUrl" class="event-card-img" alt="@ev.Title" />
                                }
                                else
                                {
                                    <div class="event-card-img-placeholder">
                                        <i class="fas fa-music"></i>
                                    </div>
                                }
                                <div class="event-card-body">
                                    <div class="event-date-badge">
                                        <i class="fas fa-calendar"></i>
                                        @ev.EventDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ar-EG"))
                                        <span class="ms-1 text-muted">@ev.EventDate.ToString("hh:mm tt")</span>
                                    </div>
                                    <h5>@ev.Title</h5>
                                    @if (!string.IsNullOrEmpty(ev.Description))
                                    {
                                        <p class="text-muted small">@ev.Description</p>
                                    }
                                    @if (!string.IsNullOrEmpty(ev.Location))
                                    {
                                        <div class="event-location">
                                            <i class="fas fa-map-marker-alt text-gold ms-1"></i> @ev.Location
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            if (past.Any())
            {
                <h3 class="text-muted mb-4 text-end"><i class="fas fa-history ms-2"></i> الفعاليات السابقة</h3>
                <div class="row g-4">
                    @foreach (var ev in past)
                    {
                        <div class="col-lg-4 col-md-6">
                            <div class="event-card" style="opacity:0.7;">
                                @if (!string.IsNullOrEmpty(ev.ImageUrl))
                                {
                                    <img src="@ev.ImageUrl" class="event-card-img" alt="@ev.Title" style="filter:grayscale(50%);" />
                                }
                                else
                                {
                                    <div class="event-card-img-placeholder" style="opacity:0.5;">
                                        <i class="fas fa-music"></i>
                                    </div>
                                }
                                <div class="event-card-body">
                                    <div class="event-date-badge" style="background:rgba(100,100,100,0.2); border-color:rgba(100,100,100,0.3); color:#888;">
                                        <i class="fas fa-calendar"></i>
                                        @ev.EventDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ar-EG"))
                                    </div>
                                    <h5>@ev.Title</h5>
                                    @if (!string.IsNullOrEmpty(ev.Description))
                                    {
                                        <p class="text-muted small">@ev.Description</p>
                                    }
                                    @if (!string.IsNullOrEmpty(ev.Location))
                                    {
                                        <div class="event-location">
                                            <i class="fas fa-map-marker-alt ms-1"></i> @ev.Location
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <div style="font-size:5rem; color:rgba(201,168,76,0.2);">
                    <i class="fas fa-calendar-times"></i>
                </div>
                <h4 class="text-muted mt-3">لا توجد فعاليات حالياً</h4>
                <p class="text-muted">تابعنا لمعرفة آخر الفعاليات القادمة</p>
            </div>
        }
    </div>
</section>