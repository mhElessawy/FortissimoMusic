@{
    ViewData["Title"] = "تسجيل الدخول";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تسجيل الدخول - Fortissimo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet" />
    <style>
        body { background: #0a0a0a; font-family: 'Cairo', sans-serif; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
        .login-box { background: #111; border: 1px solid rgba(201,168,76,0.3); border-radius: 12px; padding: 2.5rem; width: 100%; max-width: 420px; }
        .text-gold { color: #c9a84c; }
        .btn-gold { background: linear-gradient(135deg,#c9a84c,#a07830); color: #000; font-weight: 700; border: none; width: 100%; padding: .75rem; border-radius: 8px; font-size: 1rem; }
        .btn-gold:hover { background: linear-gradient(135deg,#d4b55a,#b08840); color: #000; }
        .form-control { background: #1a1a1a; border: 1px solid rgba(201,168,76,0.3); color: #fff; border-radius: 8px; }
        .form-control:focus { background: #1a1a1a; border-color: #c9a84c; color: #fff; box-shadow: 0 0 0 .2rem rgba(201,168,76,.15); }
        .form-label { color: #aaa; }
    </style>
</head>
<body>
    <div class="login-box">
        <div class="text-center mb-4">
            <img src="/images/logo.svg" height="70" alt="Fortissimo" onerror="this.style.display='none'" />
            <h4 class="text-gold mt-3 mb-0">Fortissimo Music</h4>
            <p class="text-muted small">لوحة التحكم</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger text-end">@ViewBag.Error</div>
        }

        <form method="post" asp-action="Login" asp-controller="Account">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div class="mb-3">
                <label class="form-label">البريد الإلكتروني</label>
                <input type="email" name="email" class="form-control text-end" required autofocus />
            </div>
            <div class="mb-4">
                <label class="form-label">كلمة المرور</label>
                <input type="password" name="password" class="form-control text-end" required />
            </div>
            <button type="submit" class="btn btn-gold">دخول</button>
        </form>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
